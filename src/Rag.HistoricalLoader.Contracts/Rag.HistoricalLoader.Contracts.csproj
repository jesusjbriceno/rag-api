<Project Sdk="Microsoft.NET.Sdk">

  <!-- Portable, transport-neutral control contract: no packages and no Engine/Core, SQLite, HTTP,
       credential, filesystem, or WPF reference may be added here (enforced by ControlContractTests). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
