# Copy to .env only for local Compose validation or development. Do not deploy this file.
POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=local-development-password-not-for-production

RAG_API_PORT=8080

JWT__ISSUER=rag-api
JWT__AUDIENCE=rag-api
JWT__CURRENT_SIGNING_KEY__KEY_ID=replace-at-deployment
JWT__CURRENT_SIGNING_KEY__PRIVATE_KEY_PEM=REPLACE_WITH_DEPLOYMENT_SECRET
JWT__VALIDATION_KEYS__0__KEY_ID=replace-at-deployment
JWT__VALIDATION_KEYS__0__PUBLIC_KEY_PEM=REPLACE_WITH_DEPLOYMENT_SECRET
